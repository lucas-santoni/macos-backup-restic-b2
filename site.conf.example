# Per-site configuration. Copy this file to site.conf, fill the values
# you want, then run bin/configure.sh to render the templates in
# bin/*.tmpl and config/*.tmpl into runnable scripts and configs.
#
# site.conf is .gitignored. The rendered output (bin/*.sh, config/*.toml)
# is also .gitignored. Templates (.tmpl) and this example are committed.

# macOS short username — the user-name component in /Users/<USERNAME>/.
# Used as the Keychain account name and in absolute paths inside
# profiles.toml. Match your `whoami` output.
USERNAME=""
# USERNAME="alex"

# Hostname stored in restic snapshots created by this site. Pinning this value
# keeps retention grouping stable if macOS reports a different system hostname.
BACKUP_HOST=""
# BACKUP_HOST="MacBook.local"

# Backblaze B2 repository URL. Format: b2:<bucket>:<repo-path>. The bucket
# must already exist (created in B2 web UI). The repo path is just an
# organizational prefix inside the bucket; pick anything.
B2_REPO=""
# B2_REPO="b2:my-backup-bucket:/mbp"

# Reverse-DNS prefix for the four launchd agent labels. Full identifiers
# become <LABEL_PREFIX>.{backup,forget,prune,check}. Convention:
# <tld>.<your-name>.<tool>.
LABEL_PREFIX=""
# LABEL_PREFIX="com.example.restic"

# URL that POST-receives notification JSON. The script POSTs a body shaped
# like {tool, title, content, level, emoji, extras}, authenticated with the
# secret from the NOTIFY_KEYCHAIN_SERVICE Keychain entry (see NOTIFY_AUTH).
# Optional: leave empty to disable notifications entirely. configure.sh
# will skip rendering bin/restic-notify.sh and strip the run-after hooks
# from the rendered profiles.toml. The Keychain entry isn't needed in
# that case.
NOTIFY_ENDPOINT=""
# NOTIFY_ENDPOINT="https://notify.example.com/hook"

# How restic-notify.sh authenticates (only used when NOTIFY_ENDPOINT is set):
#   bearer  "Authorization: Bearer <secret>" (default; the original gateway)
#   hmac    the secret is never sent: X-Webhook-Timestamp + X-Webhook-Signature-V2
#           = hex HMAC-SHA256 of "<timestamp>.<body>" (e.g. a Hermes webhook route)
NOTIFY_AUTH="bearer"
# Keychain service holding that secret (account = USERNAME).
NOTIFY_KEYCHAIN_SERVICE="hermes-webhook-secret"
